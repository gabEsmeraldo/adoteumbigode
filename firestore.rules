rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['gabilesmeraldo@gmail.com'];
    }

    match /listas/{id} {
      allow read, write: if allowed();
    }
  }
}
